{
	"luci-app-bandix-plus": {
		"description": "Allow Bandix Plus (bandix-plus) monitoring",
		"read": {
			"ubus": {
				"luci.bandix_plus": [
					"getHealth",
					"getBpfMaps",
					"getSnapshot",
					"getOverview",
					"getDevices",
					"getTrend",
					"getHistogram",
					"getUsageRanking",
					"getPolicy",
					"getSchedules",
					"getIfaceLimits",
					"getGuestDefaults",
					"getGuestWhitelist",
					"getVersion",
					"checkUpdate",
					"getStatus"
				],
				"luci-rpc": [
					"getBoardJSON",
					"getHostHints",
					"getNetworkDevices",
					"getWirelessDevices"
				],
				"network": [ "get_proto_handlers" ],
				"network.interface": [ "dump" ]
			},
			"uci": [ "bandix_plus", "firewall", "network", "wireless", "luci" ]
		},
		"write": {
			"ubus": {
				"luci.bandix_plus": [
					"getHealth",
					"getBpfMaps",
					"getSnapshot",
					"getOverview",
					"getDevices",
					"getTrend",
					"getHistogram",
					"getUsageRanking",
					"getPolicy",
					"getSchedules",
					"getIfaceLimits",
					"getGuestDefaults",
					"getGuestWhitelist",
					"getVersion",
					"checkUpdate",
					"getStatus",
					"deleteDevice",
					"createSchedule",
					"updateSchedule",
					"deleteSchedule",
					"setIfaceLimit",
					"deleteIfaceLimit",
					"setGuestDefault",
					"setGuestDefaultEnabled",
					"deleteGuestDefault",
					"addGuestWhitelist",
					"removeGuestWhitelist",
					"setDeviceHostname",
					"restartService"
				]
			},
			"uci": [ "bandix_plus" ]
		}
	}
}
